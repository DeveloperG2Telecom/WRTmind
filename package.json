{
  "name": "wrtmind",
  "version": "1.0.0",
  "description": "Sistema de Gerenciamento de Notas WRTmind",
  "main": "index.js",
  "scripts": {
    "dev:backend": "cd WRT-Back && npm run dev",
    "dev:frontend": "cd WRT-Front && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd WRT-Front && npm run build",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy": "npm run build && firebase deploy",
    "emulators": "firebase emulators:start",
    "emulators:ui": "firebase emulators:start --only ui",
    "firestore:rules": "firebase deploy --only firestore:rules",
    "firestore:indexes": "firebase deploy --only firestore:indexes",
    "storage:rules": "firebase deploy --only storage",
    "migrate": "cd WRT-Back && npm run migrate"
  },
  "keywords": [
    "firebase",
    "react",
    "express",
    "notas",
    "wrtmind"
  ],
  "author": "WRTmind",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "axios": "^1.10.0"
  }
}
